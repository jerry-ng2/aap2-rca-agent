flowchart TD
    %% Solid edges show the current implementation.
    %% Dotted edges show the planned task-level issue extension.
    Start([Queried unanalyzed job IDs]) --> Metadata["fetch_job_metadata()
job_name + error_message"]
    Metadata --> MetadataResult{Query succeeded or database error?}
    MetadataResult -- "Database error" --> EmptyMetadata["metadata = {}"]
    MetadataResult -- "Success" --> HistoryMode
    EmptyMetadata --> HistoryMode{Historical pre-filter enabled?}

    HistoryMode -- "--no-pre-filter" --> NoHistory["use_history = false
recent_results = []"]
    HistoryMode -- "Enabled" --> Recent["fetch_recent_results()
high confidence, analyzed, active
last 4 hours"]
    Recent --> RecentResult{Query succeeded or database error?}
    RecentResult -- "Database error" --> EmptyHistory["recent_results = []
use_history remains true"]
    RecentResult -- "Success" --> Gate
    EmptyHistory --> Gate
    NoHistory --> Gate["pre_analysis_gate()"]

    Gate --> OrderedIDs["Deduplicate input while preserving query order"]
    OrderedIDs --> SortedIDs["Iterate jobs in ascending job-ID order"]
    SortedIDs --> SignalAvailable{Job signal available?}
    SignalAvailable -- No --> Singleton["Create singleton cluster"]
    SignalAvailable -- Yes --> ClusterScore["Compare with the first job
in each existing cluster"]
    ClusterScore --> ClusterScorer["score_similarity(stage='pre_analysis')"]
    ClusterScorer --> HighConfidence{High confidence?}
    HighConfidence -- Yes --> AppendCluster["Append job to matching cluster"]
    HighConfidence -- No --> NewCluster["Create new singleton cluster"]
    Singleton --> Clusters
    AppendCluster --> Clusters
    NewCluster --> Clusters[Clusters with ascending-ID representatives]

    Clusters --> UseHistory{use_history?}
    UseHistory -- No --> Analyze
    UseHistory -- Yes --> Ambiguity["Group historical results by catalog item
catalogs with multiple root-cause categories are ambiguous"]
    Ambiguity --> RepresentativeSignal{Representative signal available?}
    RepresentativeSignal -- No --> Analyze
    RepresentativeSignal -- Yes --> HistoricalScore["Score representative against
historical results from unambiguous catalogs"]
    HistoricalScore --> HistoryScorer["score_similarity(stage='pre_analysis')"]
    HistoryScorer --> Matched{Best high-confidence match?}
    Matched -- No --> Analyze["analyze_ids in original query order"]
    Matched -- Yes --> Skip["Select highest score;
lower historical result ID wins ties"]

    Analyze --> Outputs
    Skip --> SkipTargets["skip_targets:
representative job ID -> historical result ID"]
    SkipTargets --> PreMatched["pre_matched_entries()
sorted by original query order"]
    PreMatched --> Outputs
    Clusters --> Dupes["dupes:
each duplicate job ID -> representative job ID"]
    Dupes --> Outputs([Pre-analysis outputs])

    Gate -. "ValueError, KeyError, or TypeError" .-> Fallback["Analyze all queried job IDs
no skip targets or duplicates"]
    Fallback --> Outputs

    ClusterScorer -.-> ScoringRules["Same catalog:
similarity >= 0.75 and >= 1 significant token per error
Different catalog:
similarity >= 0.90 and >= 3 significant tokens per error"]
    HistoryScorer -.-> ScoringRules

    subgraph PlannedTaskLevelIssues["Planned: task-level issues across shared roles/plays"]
        IncomingTaskContext["Fetch failed-task context before the gate
task, play, role, task_action, task_path, error_message"]
        TaskSignature["Build a task-level signature
role/play + task/action/path + specific error"]
        SharedScope["Roles, plays, and tasks are shared across CIs
task failure is the primary issue identity"]
        CanonicalLookup["Find the canonical issue
by task signature or issue_id"]
        IssueFound{Canonical issue exists?}
        LinkToIssue["Link the incoming job and CI
to the existing issue_id"]
        AnalyzeNewIssue["Continue to full analysis
the first analyzed result becomes the canonical issue"]
        CIAssociations["Lookup distinct associated CIs
WHERE id = issue_id OR related_result_id = issue_id"]
        SingleIssue["One canonical task-level issue
many associated catalog items"]
        CurrentFallback["Missing task-level context
use the current catalog + error-only signal"]
    end

    SortedIDs -.-> IncomingTaskContext
    Recent -.-> CanonicalLookup
    IncomingTaskContext --> TaskSignature
    TaskSignature --> SharedScope
    SharedScope --> CanonicalLookup
    CanonicalLookup --> IssueFound
    IssueFound -- Yes --> LinkToIssue
    IssueFound -- No --> AnalyzeNewIssue
    LinkToIssue --> CIAssociations
    AnalyzeNewIssue -.-> Analyze
    CIAssociations --> SingleIssue
    SingleIssue -.-> Outputs
    CurrentFallback -.-> SignalAvailable
