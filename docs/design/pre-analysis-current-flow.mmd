flowchart TD
    SourceDB[(Source DB)] --> Jobs([Unanalyzed jobs])
    ResultsDB[(Results DB)] --> Recent([Recent active high-confidence issues from the past 4 hours])

    subgraph Gate["Pre-analysis gate"]
        direction TB
        JobContext["Load job context
job_name + error_message"]
        Catalog["Extract catalog item
from job_name"]
        Signal["Build current match signal
catalog item + error_message"]
        Duplicate{"Same catalog item and
specific, similar error_message?"}
        Group["Group duplicate jobs
under one representative"]
        Keep["Keep job separate"]
        Known{"Known, unambiguous issue
with a similar error_message?"}
        Skip["Link to known issue
and skip full analysis"]
        Analyze["Analyze representative job"]
    end

    Jobs --> JobContext
    JobContext --> Catalog
    Catalog --> Signal
    Signal --> Duplicate
    Duplicate -- Yes --> Group
    Duplicate -- No --> Keep
    Group --> Known
    Keep --> Known
    Recent --> Known
    Known -- Yes --> Skip
    Known -- No --> Analyze

    Skip --> KnownLinks([Known-issue links])
    Analyze --> ToAnalysis([Representatives for rca-agent to analyze])
    Group --> DuplicateLinks([Duplicate links])
